# Public browser configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_SUPABASE_URL=https://replace-me.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only secrets — never expose these in browser code
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me
UPSTASH_REDIS_REST_URL=https://replace-me.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_me

# Razorpay handles INR and enabled international currencies. Checkout stays disabled until all three values are complete.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# Migration tooling only — never provide this to the running application
SUPABASE_DB_URL=postgresql://postgres:replace_me@db.replace-me.supabase.co:5432/postgres
# Development-only public records fallback. It is always disabled in production.
MYDAY_ENABLE_PREVIEW_DATA=true

# Optional, non-authoritative integrations. The core claim path never depends on these.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
